# Copy this file to `.env` (same folder) to run the server locally.
# `.env` is gitignored, so your keys never get committed. This example file is committed.

# Neon -> your project -> Connect. Keep `?sslmode=require`.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Signs access tokens. At least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Port to listen on locally. Hosts set this themselves.
PORT=8787

# Only behind a proxy (any host): the header holding the client's IP.
# CLIENT_IP_HEADER=x-forwarded-for

# Email (password reset codes) through resend.com. Leave empty while developing:
# codes are then printed in the server's output instead.
# RESEND_API_KEY=
# Sender address. onboarding@resend.dev only delivers to the email you signed up
# to Resend with; verify your own domain in Resend to email anyone.
# Quote it: the space and <> stop the rest of this file being read otherwise.
# (In the Render dashboard, leave the quotes off.)
# EMAIL_FROM="Axiom <onboarding@resend.dev>"

# Who runs the waiting list: comma-separated emails. They skip it themselves and
# see "Waiting list" under Account in the app, where they approve new accounts.
# ADMIN_EMAILS=you@example.com
# New accounts wait for an admin's approval before they can sign in and sync.
# On unless set to off.
# WAITLIST=on
