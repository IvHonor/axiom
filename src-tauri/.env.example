# Copy to src-tauri/.env (git ignores it) and fill in what you need.
# Read when the app is built; see docs/DEVELOPMENT.md.

# The account server. Development builds default to http://localhost:8787.
# AXIOM_SERVER_URL=

# Google Calendar: an OAuth client of type "Desktop app".
AXIOM_GOOGLE_CLIENT_ID=
AXIOM_GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365: the app registration's Application (client) ID.
AXIOM_MICROSOFT_CLIENT_ID=

# YouTube playlist import in Learning: an API key from Google Cloud with the
# "YouTube Data API v3" enabled (restrict it to that API). Empty hides the import.
AXIOM_YOUTUBE_API_KEY=
